generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HR
  SALES
  EMPLOYEE
  CONTRACTOR
  CLIENT
  PUBLIC
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INTERIOR
  ENGINEERING
  MEP
  RENOVATION
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  REVIEWED
  CONTACTED
  ARCHIVED
}

enum ContentPublishStatus {
  DRAFT
  PUBLISHED
}

enum CertificationDocumentType {
  GOSI
  VAT
  ZAKAT
  TRADE_LICENSE
  SAUDIZATION
  SAFETY_CERTIFICATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(PUBLIC)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile                         Profile?
  accounts                        Account[]
  sessions                        Session[]
  authenticators                  Authenticator[]
  projects                        Project[]                @relation("ProjectOwner")
  rfqSubmissionsReviewed          RFQSubmission[]          @relation("RFQReviewer")
  jobApplicationsReviewed         JobApplication[]         @relation("JobReviewer")
  contractorRegistrationsReviewed ContractorRegistration[] @relation("ContractorReviewer")
  certifications                  Certification[]          @relation("CertificationIssuer")
  auditLogs                       AuditLog[]               @relation("AuditActor")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  position         String?
  bioEn            String?
  bioAr            String?
  companyMissionEn String?
  companyMissionAr String?
  companyVisionEn  String?
  companyVisionAr  String?
  coreServicesEn   String[] @default([])
  coreServicesAr   String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Project {
  id            String          @id @default(cuid())
  slug          String          @unique
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  location      String
  city          String
  year          Int?
  category      ProjectCategory
  status        PublishStatus   @default(DRAFT)
  featured      Boolean         @default(false)
  completedAt   DateTime?
  sortOrder     Int             @default(0)
  ownerId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  owner User? @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  images ProjectImage[]

  @@index([category, status], map: "idx_projects_category_status")
  @@index([featured, status], map: "idx_projects_featured_status")
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  altEn     String?
  altAr     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_images_project_id")
  @@map("project_images")
}

model RFQSubmission {
  id              String           @id @default(cuid())
  fullName        String
  email           String
  phone           String
  companyName     String?
  serviceType     String?
  projectLocation String?
  estimatedBudget String?
  message         String
  status          SubmissionStatus @default(NEW)
  internalNotes   String?
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  contactedAt     DateTime?
  handledById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  handledBy User? @relation("RFQReviewer", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([submittedAt], map: "idx_rfq_submissions_submitted_at")
  @@map("rfq_submissions")
}

model JobApplication {
  id              String           @id @default(cuid())
  fullName        String
  email           String
  phone           String
  positionApplied String
  coverLetterEn   String?
  coverLetterAr   String?
  resumeUrl       String?
  status          SubmissionStatus @default(NEW)
  internalNotes   String?
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  contactedAt     DateTime?
  handledById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  handledBy User? @relation("JobReviewer", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([submittedAt], map: "idx_job_applications_submitted_at")
  @@map("job_applications")
}

model ContractorRegistration {
  id          String           @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  website     String?
  servicesEn  String[]         @default([])
  servicesAr  String[]         @default([])
  notes       String?
  status      SubmissionStatus @default(NEW)
  internalNotes String?
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?
  contactedAt DateTime?
  handledById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  handledBy      User?           @relation("ContractorReviewer", fields: [handledById], references: [id], onDelete: SetNull)
  certifications Certification[]

  @@index([submittedAt], map: "idx_contractor_registrations_submitted_at")
  @@map("contractor_registrations")
}

model Certification {
  id                        String   @id @default(cuid())
  contractorRegistrationId  String?
  issuedById                String?
  title                     String
  titleAr                   String?
  documentType              CertificationDocumentType @default(SAFETY_CERTIFICATE)
  issuingAuthority          String
  certificateNumber         String?
  issuedAt                  DateTime
  issueDate                 DateTime?
  expiresAt                 DateTime?
  expiryDate                DateTime?
  certificateUrl            String?
  showOnPublicGrid          Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  contractorRegistration ContractorRegistration? @relation(fields: [contractorRegistrationId], references: [id], onDelete: Cascade)
  issuedBy               User?                   @relation("CertificationIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("certifications")
}

model ContentSection {
  id         String               @id @default(cuid())
  sectionKey String               @unique
  titleEn    String
  titleAr    String
  bodyEn     String
  bodyAr     String
  status     ContentPublishStatus @default(DRAFT)
  updatedBy  String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@map("content_sections")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  timestamp  DateTime @default(now())
  metadata   Json?

  admin User? @relation("AuditActor", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId], map: "idx_audit_logs_admin_id")
  @@index([action], map: "idx_audit_logs_action")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}